# Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar

# Android — local SDK path, per-dev only
local.properties

# Signing keys. The release key lives only in the android-release environment's
# secrets (docs/android-release-signing.md); the debug keystore is committed on
# purpose (android-app/build.gradle.kts) and un-ignored below.
*.p12
*.jks
*.keystore
!android-app/debug.keystore

# Built app packages are workflow artifacts, never committed
*.apk
*.aab
output-metadata.json

# Android Studio generated files and folders
captures/
.externalNativeBuild/
.cxx/
*.hprof

# Compiled class files
*.class

# IntelliJ IDEA / Android Studio
.idea/
*.iml
*.iws
*.ipr
out/

# Eclipse
.classpath
.project
.settings/

# macOS
.DS_Store
._*

# Kotlin incremental-compile scratch + ad-hoc daemon logs
.kotlin/
*.log

# Xcode: the iOS app's project and Info.plist are generated from ios-app/xcode/project.yml
# (XcodeGen), and per-user state
ios-app/xcode/Serotine.xcodeproj/
ios-app/xcode/Serotine/Info.plist
# The app icon, rendered by the Xcode build's Gradle phase (:ios-app:generateAppIcon)
ios-app/xcode/Serotine/Assets.xcassets/AppIcon.appiconset/AppIcon.png
xcuserdata/
*.xcworkspace/xcuserdata/
DerivedData/

__pycache__/

# Claude Code's per-user permission grants. The shared rules and skills in
# .claude/ are committed on purpose (CLAUDE.md, "How these instructions are organized").
.claude/settings.local.json
