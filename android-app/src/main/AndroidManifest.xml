<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Network-upgrade notices (the app asks once, on Android 13 and later), and the daily
         upgrade check and the reminder alarm surviving a reboot. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- The biometric prompt that unlocks a key, where the user turned biometric unlock on
         (the key store's library declares it too, for its own checks). -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Scanning a dApp's WalletConnect QR code on Connect a dApp: asked for on the first tap of
         Scan, and the frames are decoded on the device. Not required: a device without a camera
         still installs the app, and pastes the link instead. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Both: Android infers a REQUIRED android.hardware.camera from the permission unless it is
         declared not required. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <application
        android:name=".SerotineApplication"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:theme="@style/Theme.Serotine">

        <!-- adjustResize: Android 10 (API 29) reports the keyboard's height to the app only with it,
             and the screens end at the keyboard by that height (App.kt). -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- A WalletConnect link a dApp or a browser opens (docs/walletconnect.md, part 1.2a): it
                 lands on Connect a dApp, filled in, and pairs only on the user's Connect. singleTask,
                 so that a link reaches the running app (onNewIntent) rather than a second one. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="wc" />
            </intent-filter>
        </activity>

        <!-- The reminder alarm, and arming it again after a reboot or an update. Not exported:
             only the system's own broadcasts and the app's alarm reach it. -->
        <receiver
            android:name=".upgrade.UpgradeReminderReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- The daily look for network upgrades while the app is closed. -->
        <service
            android:name=".upgrade.UpgradeCheckJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- The networking kept on for a minute after the app's last screen left the foreground. -->
        <service
            android:name=".GracePeriodJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- The exchange-rate widget. Not exported: the system's widget host reaches it anyway,
             and no other app may make it draw. -->
        <receiver
            android:name=".widget.RateWidget"
            android:exported="false"
            android:label="@string/rate_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/rate_widget_info" />
        </receiver>

        <!-- The widget's configuration: which network's rate a widget being placed shows. Exported,
             as the launcher opens it; it acts only on a widget id of this app's own RateWidget. -->
        <activity
            android:name=".widget.RateWidgetConfigureActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="@string/rate_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- The widget's refresh while the app is closed: on an unmetered network only. -->
        <service
            android:name=".widget.RateRefreshJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
    </application>
</manifest>
